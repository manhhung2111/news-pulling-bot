# Copy to /etc/ai-eng-digest/digest.env and chmod 600.
export DISCORD_BOT_TOKEN=""
# From `claude setup-token` (uses your Claude Pro subscription).
export CLAUDE_CODE_OAUTH_TOKEN=""
# Optional fallback. Leave empty to run with Claude only.
export GEMINI_API_KEY=""
# cron has a minimal PATH; make sure the claude CLI is on it.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
